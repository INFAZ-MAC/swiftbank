<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="1200.0" style="-fx-background-color: #F4F6F9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.swiftbanksystem.controller.LoginController">
   <children>
      <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <!-- ===================== BRAND PANEL ===================== -->
            <VBox minWidth="450.0" prefWidth="450.0" style="-fx-background-color: #0B2A4A;">
               <padding>
                  <Insets bottom="32.0" left="44.0" right="44.0" top="36.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <StackPane prefHeight="38.0" prefWidth="38.0" style="-fx-background-color: #1FA37A; -fx-background-radius: 10;">
                           <children>
                              <Label style="-fx-font-size: 18px;" text="⚡" textFill="WHITE" />
                           </children>
                        </StackPane>
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="SwiftBank" textFill="WHITE" />
                     </children>
                  </HBox>

                  <Region VBox.vgrow="ALWAYS" />

                  <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="BUILT FOR EVERY BANKING DAY" textFill="#35C48F" />
                  <Label style="-fx-font-size: 36px; -fx-font-weight: bold;" text="Good banking.&#10;Great confidence." textFill="WHITE" wrapText="true">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Label style="-fx-font-size: 13px;" text="One secure workspace for your customers, accounts and everyday operations." textFill="#8FA3BA" wrapText="true">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                  </Label>

                  <Region VBox.vgrow="ALWAYS" />

                  <!-- Card illustration -->
                  <StackPane prefHeight="210.0">
                     <children>
                        <VBox maxHeight="-Infinity" maxWidth="330.0" prefHeight="180.0" prefWidth="330.0" spacing="10.0" style="-fx-background-color: linear-gradient(to bottom right, #1E5A6B, #153A5F); -fx-background-radius: 16; -fx-border-color: #2C6E80; -fx-border-radius: 16;" StackPane.alignment="TOP_LEFT">
                           <padding>
                              <Insets bottom="18.0" left="20.0" right="20.0" top="16.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="SwiftBank" textFill="WHITE" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="))" textFill="#8FC9D6" />
                                 </children>
                              </HBox>
                              <Region maxHeight="24.0" maxWidth="34.0" minHeight="24.0" minWidth="34.0" style="-fx-background-color: #3F7F8F; -fx-background-radius: 5;" />
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="●●●●   ●●●●   ●●●●   2048" textFill="WHITE" />
                              <Region VBox.vgrow="ALWAYS" />
                              <Label style="-fx-font-size: 8px;" text="A SMARTER WAY TO BANK" textFill="#8FC9D6" />
                           </children>
                        </VBox>
                        <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 10;" StackPane.alignment="BOTTOM_RIGHT">
                           <padding>
                              <Insets bottom="8.0" left="12.0" right="14.0" top="8.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 16px;" text="🛡" textFill="#1FA37A" />
                              <VBox>
                                 <children>
                                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Secure by design" textFill="#0B2A4A" />
                                    <Label style="-fx-font-size: 9px;" text="Protected. Connected." textFill="#6B7A90" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </StackPane>

                  <Region VBox.vgrow="ALWAYS" />

                  <Label style="-fx-font-size: 11px;" text="Trusted service. Stronger relationships." textFill="#8FA3BA" />
                  <Label style="-fx-font-size: 10px;" text="© 2026 SwiftBank. All rights reserved." textFill="#8FA3BA">
                     <VBox.margin>
                        <Insets top="2.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>

            <!-- ===================== LOGIN FORM ===================== -->
            <StackPane HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="18.0">
                     <children>
                        <VBox prefWidth="410.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E3E8EF; -fx-border-radius: 12;">
                           <padding>
                              <Insets bottom="28.0" left="32.0" right="32.0" top="30.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <StackPane prefHeight="28.0" prefWidth="28.0" style="-fx-background-color: #1FA37A; -fx-background-radius: 8;">
                                       <children>
                                          <Label style="-fx-font-size: 14px;" text="⚡" textFill="WHITE" />
                                       </children>
                                    </StackPane>
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="SwiftBank" textFill="#0B2A4A" />
                                 </children>
                              </HBox>
                              <Label style="-fx-font-size: 26px; -fx-font-weight: bold;" text="Welcome back" textFill="#0B2A4A">
                                 <VBox.margin>
                                    <Insets top="8.0" />
                                 </VBox.margin>
                              </Label>
                              <Label style="-fx-font-size: 12px;" text="Log in to your branch workspace to continue." textFill="#6B7A90">
                                 <VBox.margin>
                                    <Insets bottom="6.0" />
                                 </VBox.margin>
                              </Label>

                              <VBox spacing="4.0">
                                 <children>
                                    <Label style="-fx-font-size: 11px;" text="Username" textFill="#6B7A90" />
                                    <TextField fx:id="txtUsername" prefHeight="38.0" promptText="Enter your username" style="-fx-background-color: white; -fx-border-color: #D5DBE3; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                 </children>
                              </VBox>

                              <VBox spacing="4.0">
                                 <children>
                                    <Label style="-fx-font-size: 11px;" text="Password" textFill="#6B7A90" />
                                    <StackPane>
                                       <children>
                                          <TextField fx:id="txtPasswordVisible" managed="false" prefHeight="38.0" promptText="Enter your password" style="-fx-background-color: white; -fx-border-color: #D5DBE3; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 40 0 10;" visible="false" />
                                          <Button fx:id="btnTogglePassword" focusTraversable="false" onAction="#handleTogglePassword" style="-fx-background-color: transparent; -fx-text-fill: #6B7A90; -fx-cursor: hand;" text="👁" StackPane.alignment="CENTER_RIGHT" />
                                          <PasswordField fx:id="txtPassword" prefHeight="38.0" promptText="Enter your password" style="-fx-background-color: white; -fx-border-color: #D5DBE3; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 40 0 10;" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </VBox>

                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <CheckBox fx:id="chkRemember" mnemonicParsing="false" selected="true" style="-fx-font-size: 11px; -fx-text-fill: #0B2A4A;" text="Remember username" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Hyperlink fx:id="hlForgot" style="-fx-text-fill: #1FA37A; -fx-font-size: 11px; -fx-font-weight: bold; -fx-border-color: transparent;" text="Forgot password?" />
                                 </children>
                              </HBox>

                              <Label fx:id="lblError" style="-fx-font-size: 11px;" text="Invalid username or password" textFill="#D9534F" visible="false" />

                              <Button fx:id="btnLogin" defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#handleLogin" prefHeight="42.0" style="-fx-background-color: #1FA37A; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="Login   →" />

                              <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-size: 10px;" text="🔒  Authorized personnel only · Secure connection" textFill="#6B7A90" />
                           </children>
                        </VBox>
                        <Label style="-fx-font-size: 11px;" text="Need access? Contact your branch administrator." textFill="#6B7A90" />
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </HBox>
   </children>
</AnchorPane>
